# 실증(/pilot) 설정 예시 — 값은 Vercel 프로젝트 설정(Environment Variables)에 넣는다. 이 파일에 실제 값을 쓰지 않는다.
# 없으면 실증 화면만 '설정 안 됨'으로 보이고 데모 화면은 그대로 동작한다.

# Supabase 프로젝트 주소와 공개 키 (Project Settings → API Keys 의 Publishable key). RLS 로 보호되므로 브라우저에 보여도 된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 화면 띠에 표시할 DB 이름 — 개발용과 실증용을 헷갈리지 않게 (예: 실증 DB)
NEXT_PUBLIC_PILOT_DB_LABEL=

# 판단 기록 서명키 (서버 전용, 32자 이상 무작위). DB 의 pilot_private.settings('judge_secret')와 같은 값.
# 이 키로는 '판단 대기열 1건 읽기·기록'만 할 수 있다. Supabase 관리자 키(service_role/secret)는 앱에 넣지 않는다.
PILOT_JUDGE_SECRET=

# 로컬에서만: 판단 기록에 남길 프로그램 커밋 (Vercel 은 VERCEL_GIT_COMMIT_SHA 를 자동으로 쓴다)
PILOT_APP_COMMIT=
